# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Vite / TypeScript
node_modules/
app/.tmp/
app/dist/
*.tsbuildinfo

# Rust / Tauri
app/src-tauri/target/
app/src-tauri/gen/

# PyInstaller output. The sidecar binary is a build product: reproduce it
# with scripts/build_sidecar.py rather than committing a 20 MB exe.
app/src-tauri/binaries/

# Local logs and scratch output
*.log
scripts/probe_*.jsonl
scripts/k2.py

# Environment / secrets. API keys belong in the OS keyring, never on disk.
.env
.env.*
!.env.example

# The stray zero-byte files that used to live here (type names such as `dict`,
# `AsyncOpenAI`, `list[str]` created by mistyped shell redirects) were removed.
# They are deliberately NOT ignored any more: a future stray file should show up
# as untracked rather than be silently hidden by a name on this list.

# Freebuff's own project metadata
/.freebuff/

# PyInstaller intermediate output (the sidecar exe itself is ignored above)
build/
scripts/build/

# `tauri icon` also emits Android and iOS rasters. TONYAgent is desktop-only,
# so those are not regenerated or shipped.
app/src-tauri/icons/android/
app/src-tauri/icons/ios/
