{
  "name": "tonyagent-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:proto": "node -e \"require('fs').rmSync('.tmp',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test \".tmp/**/*.test.js\"",
    "test": "npm run build:proto"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "jsdom": "^30.1.1",
    "tsx": "^4",
    "typescript": "^5",
    "vite": "^7"
  }
}
